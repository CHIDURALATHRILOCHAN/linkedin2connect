# ==========================================
# Achievement2LinkedIn Environment Configuration
# ==========================================

# Application Settings
APP_NAME=Achievement2LinkedIn
ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DATABASE_URL=sqlite:///./achievement2linkedin.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/achievement2linkedin

# Frontend URL for OAuth redirects & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security & Encryption
ENCRYPTION_KEY=32-character-secret-encryption-key-12345

# Mock Modes (set to true for instant dev testing without API keys)
AI_MOCK_MODE=true
LINKEDIN_MOCK_MODE=true

# Official LinkedIn API Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/callback
LINKEDIN_API_VERSION=202508

# AI Configuration (OpenAI or Gemini)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# File Storage Configuration (local or S3)
STORAGE_PROVIDER=local
STORAGE_DIR=uploads
STORAGE_BUCKET=achievement2linkedin-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
